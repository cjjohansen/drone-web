{
  "info": {
    "name": "Partner Catalog Syndication API",
    "description": "Bulk catalog data, batch availability, and batch pricing for partner systems. Covers JS6 (Partner Catalog Access).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key" },
      { "key": "value", "value": "{{apiKey}}" },
      { "key": "in", "value": "header" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.droneparts.com/partner-catalog/v1" },
    { "key": "apiKey", "value": "partner-api-key" }
  ],
  "item": [
    {
      "name": "JS6 — Partner Catalog Access",
      "item": [
        {
          "name": "Get catalog feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/feed?lastUpdatedSince=2026-02-01T00:00:00Z&offset=0&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["feed"],
              "query": [
                { "key": "lastUpdatedSince", "value": "2026-02-01T00:00:00Z" },
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "100" }
              ]
            }
          }
        },
        {
          "name": "Get batch availability",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/availability",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"productIds\": [\"prod-001\", \"prod-010\", \"prod-020\"] }"
            }
          }
        },
        {
          "name": "Get batch pricing",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pricing",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"productIds\": [\"prod-001\", \"prod-010\"] }"
            }
          }
        }
      ]
    }
  ]
}
